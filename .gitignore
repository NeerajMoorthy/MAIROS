# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest-temp*/
.ruff_cache/

# Environment — never commit real API keys
.env
.env.local
.env.*.local
!.env.example

# Runtime data (Chroma index, knowledge graphs, uploads, state snapshot)
apps/api/data/

# Deployment bundles assembled from the repository (scripts/build_hf_space.py)
build/

# Node
node_modules/
.next/
.next-dev/
.open-next/
.wrangler/
.vercel/
.dev.vars
out/
npm-debug.log*
*.tsbuildinfo

# Scratch renders and drafts. The scripts in tmp/ that generate and check the
# test PDFs in output/pdf are kept; what they render is not.
tmp/**/*.png
tmp/**/*.webp
tmp/**/*.pptx
tmp/**/*.ndjson

# Logs and local databases outside apps/api/data
*.log
*.db-wal
*.db-shm

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
