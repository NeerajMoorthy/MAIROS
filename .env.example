# MAIROS environment configuration
# Copy to `.env` in this same directory (mairos/.env) and fill in your key.
# `.env` is gitignored — never commit a real key.

# ---------------------------------------------------------------------------
# LLM provider — Groq (free tier available at https://console.groq.com/keys)
# ---------------------------------------------------------------------------
# Without this the backend still runs: it falls back to a deterministic
# offline model so the pipeline is demoable, but answers are extractive only.
GROQ_API_KEY=

# Production model IDs (see https://console.groq.com/docs/models):
#   llama-3.3-70b-versatile   - best quality, used for reasoning/synthesis
#   llama-3.1-8b-instant      - fastest, used for routing/extraction
#   openai/gpt-oss-120b
DEFAULT_LLM=llama-3.3-70b-versatile
FAST_LLM=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1400
# Knowledge-graph extraction's own output budget. Reasoning models (gpt-oss)
# spend part of any budget thinking before they answer; at 1400 their entity
# JSON was cut off and the graph stayed empty.
LLM_EXTRACTION_MAX_TOKENS=4096
# Any other agent's reply that reaches LLM_MAX_TOKENS is retried once with this.
LLM_RETRY_MAX_TOKENS=4096

# Set false to make a missing key a hard error instead of degrading offline.
ALLOW_OFFLINE_LLM=true

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
CHROMA_COLLECTION=mairos_chunks
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=512
CHUNK_OVERLAP=64
DEFAULT_TOP_K=5

# ---------------------------------------------------------------------------
# Literature retrieval — arXiv, OpenAlex and Semantic Scholar, all free.
# Only titles, abstracts and metadata are fetched, never full texts.
# ---------------------------------------------------------------------------
LITERATURE_SOURCES=arxiv,openalex,semantic_scholar
# Papers kept after merging every source and query.
LITERATURE_MAX_RESULTS=8
# Queries per search (the live model writes all but the first) and results
# requested per query from each source.
LITERATURE_QUERY_COUNT=4
LITERATURE_PER_QUERY=5
LITERATURE_TIMEOUT=20
# Most seconds Semantic Scholar (queried one request at a time) may spend.
LITERATURE_SOURCE_DEADLINE=40
# Optional: an email address puts OpenAlex requests in its faster polite pool.
OPENALEX_MAILTO=
# Optional but recommended: without a key, Semantic Scholar shares a public
# rate limit and often answers 429 (the coverage report then says so).
# Free key: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ---------------------------------------------------------------------------
# HTTP hardening
# ---------------------------------------------------------------------------
# CORS: an explicit list of origins, never "*". Comma-separated, or JSON.
# CORS_ORIGINS=["http://localhost:3000"]
# The API authenticates with a bearer header, never cookies, so leave false.
CORS_ALLOW_CREDENTIALS=false

# Fixed-window rate limits per client address, per worker process. Anything
# that starts agent work (a task, an upload, an evaluation run) draws on the
# write budget; everything else draws on the read budget.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_READS=240
RATE_LIMIT_WRITES=20

# Request body caps, checked from Content-Length before the body is read.
MAX_REQUEST_BYTES=1048576
MAX_UPLOAD_BYTES=41943040

# DEBUG turns on per-request detail; INFO is one JSON line per request.
LOG_LEVEL=INFO

# ===========================================================================
# Deployment (all optional — leave empty for the local-first defaults)
# See docs/DEPLOYMENT.md for the full Supabase / Fly.io / Cloudflare setup.
# ===========================================================================

# Move every data path (uploads, Chroma, graphs, SQLite) under one directory,
# e.g. a Fly.io volume mounted at /data.
# DATA_DIR=/data

# Supabase Postgres for projects, documents, papers, patents and tasks.
# Empty = SQLite. Use the pooler connection string (port 6543).
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Better Auth (runs in the Next.js frontend). Setting AUTH_JWKS_URL turns on
# authentication and per-user project isolation in the API. Empty = local
# single-user mode, no login.
# AUTH_JWKS_URL=https://mairos.example.com/api/auth/jwks
# AUTH_ISSUER=https://mairos.example.com
# AUTH_AUDIENCE=https://mairos.example.com
